    <!-- 环境 -->
    <profiles>
        <!-- 开发 -->
        <profile>
            <id>dev</id>
            <activation>
                <!--默认激活配置-->
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!--当前环境-->
                <profiles.active>dev</profiles.active>
                <!--                <database.type>postgresql</database.type>-->
                <database.type>mysql8</database.type>
                <!--代码构建控制-->
                <!--跳过构建源代码包-->
                <skip.build.source.package>false</skip.build.source.package>
                <!--不copy代码包到docker构建目录-->
                <skip.copy.docker.resource>false</skip.copy.docker.resource>
                <!--不执行git commit 构建-->
                <skip.build.git.commit.info>false</skip.build.git.commit.info>


                <nacos.namespace>public</nacos.namespace>
                <nacos.group>DEFAULT_GROUP</nacos.group>
                <yaml.prefix>widdo</yaml.prefix>
                <yaml.prefix.default>application</yaml.prefix.default>
                <yaml.suffix>environment</yaml.suffix>
            </properties>
        </profile>
    </profiles>

    <build>
        <resources>
            <!-- 先指定 src/main/resources下所有文件及文件夹为资源文件 -->
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
                <filtering>true</filtering>
            </resource>
        </resources>
        <pluginManagement>
            <plugins>

                <!-- Spring Boot 打包插件。自动配置，默认启用了资源过滤，并自动处理了常见资源文件。
                       默认行为：
                           1. 自动开启过滤：对src/main/resources下的所有文件启用过滤
                           2. 特殊占位符处理：支持springboot特有的@...@占位符（如@project.version@）
                           3. 配置文件优先：特别处理application*.yml和application*.properties

                       Maven的默认行为：
                           1. 复制但不过滤：默认执行资源复制，复制src/main/resources,src/test/resources,但filtering默认为false
                           2. 保留原文件：所有资源文件鸳鸯复制到target/classes


                       maven项目中配置了<resources>部分后，仍然需要maven-resources-plugins,但是不需要额外配置该插件了，因为该插件是maven默认生命周期的一部分，即使在pom中没有配置，
                       maven也会在process-resources阶段执行它。但是这样的话，如果我们要自定义资源处理，就必须在<build><resources></resources></build>中配置，或者显示配置
                       maven-resources-plugin.


                       总结就是maven-resources-plugin 和 spring-boot-maven-plugin都是必选的，前者需要配置资源过滤，后者不需要。自定义资源可以使用前者或者 <resources>。如果用了
                       <resources>，就不需要显示配置maven-resources-plugin插件了，因为它是maven声明周期默认的一部分。
                    -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot-dependencies.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                        <!--分层打包优化-->
                        <layers>
                            <enabled>true</enabled>
                        </layers>
                    </configuration>
                </plugin>


                <!-- 安全扫描插件 -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>aggregate</goal>
                            </goals>
                        </execution>
                    </executions>
       <!--             <configuration>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <suppressionFile>security/suppressions.xml</suppressionFile>
                    </configuration>-->
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven-antrun-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>delete-jar-file</id>
                            <phase>pre-clean</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <delete file="${docker.build.directory}/${docker.resource.name}"/>
                                </target>
                            </configuration>
                        </execution>
                        <execution>
                            <id>prepare-docker-resource</id>
                            <phase>package</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <!--jar包保存位置 -->
                                    <copy todir="${docker.build.directory}">
                                        <fileset dir="${project.basedir}/target">
                                            <include name="${docker.resource.name}"/>
                                        </fileset>
                                    </copy>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <!--是 Maven 构建生命周期中执行单元测试的核心插件，其名称 "Surefire" 寓意着它能可靠地验证代码质量。它在 test 阶段自动触发，负责运行项目的单元测试（JUnit、TestNG 等），并生成详细的测试报告。
                        核心功能
                            1. 自动化测试执行
                                - 在 mvn test 或 mvn verify 时，自动执行 src/test/java 下的所有测试类
                            2. 测试报告生成，生成两种格式的报告
                                - 控制台输出：实时显示测试进度和结果
                                - xml/html 报告（默认路径：target/surefire-reports）
                            3. 测试流程控制
                                参数                          作用                          实例命令
                                -Dtest=MyTest            运行单个测试类                   mvn test -Dtest=MyTest
                                -Dtest=MyTest#Test*      运行类中特定方法                 mvn test -Dtest=MyTest#testAdd
                                -DfailIfNoTests=false    无测试时构建不失败（默认true）
                                -DskipTests              跳过测试                        mvn install -DskipTests
                    -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- 包含/排除测试用例 -->
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                        <excludes>
                            <exclude>**/*IntegrationTest.java</exclude>
                        </excludes>

                        <!-- 并行执行测试 -->
                        <parallel>methods</parallel>
                        <threadCount>4</threadCount>

                        <!-- 测试超时设置 -->
                        <forkedProcessTimeoutInSeconds>30</forkedProcessTimeoutInSeconds>

                        <!-- 关键配置：无测试时不报错。默认true：必须有测试类，设置false：没有测试也可以-->
                        <failIfNoTests>false</failIfNoTests>
                    </configuration>
                </plugin>

