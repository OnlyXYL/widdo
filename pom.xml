    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.widdo</groupId>
                <artifactId>widdo-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
