            <!--maven的compiler插件，默认只支持jdk1.3，因此需要指定jdk版本。
            负责 Java 源代码的编译。它在 Maven 生命周期的 compile 阶段自动触发，将 .java 文件编译为 .class 字节码文件，是项目构建过程中不可或缺的环节。
            <source> 指定源代码兼容的JDK版本
            <target> 指定生成的字节码版本
            <release> 同时设置source/target
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <!--jdk8和更早版本，编译器指定jdk版本方式-->
                    <!--<source>${java.version}</source>
                    <target>${java.version}</target>-->

                    <!--jdk9+ 之后，推荐使用 release 代替 source + target -->
                    <release>${java.version}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <showWarnings>true</showWarnings>
                    <annotationProcessorPaths>
                        <!--添加lombok处理器，解决lombok注解不生效-->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct-processor.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot-dependencies.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--主要负责项目资源文件的复制、过滤和预处理。它在 Maven 生命周期的 process-resources 和 process-test-resources 阶段自动执行，是项目构建中不可或缺的基础设施。
                核心功能：
                    1. 资源复制与定位
                        - 将src/main/resources下的文件复制到target/classes
                        - 将src/test/resources下的文件复制到target/test-classes
                        - 支持自定义资源目录配置
                    2. 资源过滤（动态替换）
                        在资源文件中使用${property}占位符，构建时自动替换为实际值
                    3. 多环境配置支持
                        - 通过profile实现环境差异化配置
                    4. 自定义分隔符（避免与框架冲突）

            -->
            <!--当前配置有了resources，这里可以不用配置了-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <configuration>
                    <!--自定义分隔符-->
                    <delimiters>${resource.delimiter}</delimiters>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                </configuration>
            </plugin>


            <!--主要功能是将项目源代码打包成独立的 JAR 文件（通常称为 -sources.jar）。这个插件解决了开发过程中源代码访问的关键需求，尤其在依赖管理和调试场景中至关重要。-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <configuration>
                    <skipSource>${skip.build.source.package}</skipSource>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--是 Maven 生态中用于自动化管理依赖版本和插件版本的核心工具。它专注于解决项目依赖的版本升级、降级、冲突检测等维护难题，显著提升依赖管理的效率。
                核心功能：
                    1. 依赖版本检查与升级
                        1.1 检测可用更新  mvn versions:display-dependency-updates. 扫描所有依赖，列出可用的新版本
                        1.2 自动升级依赖  mvn versions:use-latest-versions.自动将素有依赖升级到最新版本 （谨慎使用）
                    2. 插件版本管理
                        2.1 检查插件更新  mvn versions:display-plugin-updates. 列出项目中所有maven插件的可用新版本
                        2.2 升级插件版本  mvn versions:update-plugins. 将插件升级到最新版本
                    3. 版本冲突解决
                        3.1 检测依赖冲突  mvn versions:display-dependency-updates. 间接显示因版本冲突导致的依赖树问题
                        3.2 统一版本号    mvn versions:use-releases -Dincludes=com.google.guava:guava. 强制指定某个依赖的版本
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-maven-plugin.version}</version>
                <configuration>
                    <!-- 仅检查重大更新 -->
                    <allowMajorUpdates>false</allowMajorUpdates>
                    <!-- 排除特定依赖 -->
                    <excludes>
                        <exclude>org.junit.jupiter:junit-jupiter</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--打包jar 与git commit 关联插件。工作流程：
                1. 构建触发：执行 mvn package 或者 mvn install
                2. 信息采集：插件读取本地.get目录的元数据
                3. 文件生成：在target/classes/git.properties生成属性文件
                4. 资源打包：该文件被打包进最终产物（JAR/WAR）
            -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>${git-commit-id-plugin.version}</version>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <!--因为项目定制了jackson的日期时间序列化/反序列化格式，因此这里要进行配置,不然通过management.info.git.mode=full进行完整git信息监控时会存在问题-->
                    <dateFormat>yyyy-MM-dd HH:mm:ss</dateFormat>
                    <includeOnlyProperties>
                        <includeOnlyProperty>git.branch</includeOnlyProperty>
                        <includeOnlyProperty>^git.build.(time|version)$</includeOnlyProperty>
                        <includeOnlyProperty>^git.commit.(id|message|time).*$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <!--checkstyle：校验代码规范-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>configurations/style/sun_checks.xml</configLocation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <!--                <version>${maven.jxr.version}</version>-->
                <version>2.5</version>
            </plugin>
        </plugins>
    </reporting>
</project>